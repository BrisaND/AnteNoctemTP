    \"UnityEditor.ShaderGraph.StickyNoteData\",\n    \"m_ObjectId\": \"90435d9ccc89451bb5877b3d5c2047ff\",\n   
    \"m_Title\": \"Viento\",\n    \"m_Content\": \"Usando la funci\xF3n Seno, el
    objeto (si se le puede llamar as\xED) oscila entre 1 y -1, realizando, justamente,
    un movimiento oscilante. Se utiliza la coordenada V (es decir, Y) = 0 para la
    base y la punta en V =1. Se multiplica el desplazamiento por el canal V, en la
    base es 0x viento =0 y en las puntas 1 x viento = se mueve\",\n    \"m_TextSize\":
    0,\n    \"m_Theme\": 0,\n    \"m_Position\": {\n        \"serializedVersion\":
    \"2\",\n        \"x\": -990.0,\n        \"y\": -316.0,\n        \"width\": 200.0,\n       
    \"height\": 173.29385375976563\n    },\n    \"m_Group\": {\n        \"m_Id\":
    \"\"\n    }\n}\n\n{\n    \"m_SGVersion\": 0,\n    \"m_Type\": \"UnityEditor.ShaderGraph.Vector1MaterialSlot\",\n   
