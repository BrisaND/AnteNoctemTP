{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "90435d9ccc89451bb5877b3d5c2047ff",
    "m_Title": "Viento",
    "m_Content": "Usando la función Seno, el objeto (si se le puede llamar así) oscila entre 1 y -1, realizando, justamente, un movimiento oscilante. Se utiliza la coordenada V (es decir, Y) = 0 para la base y la punta en V =1. Se multiplica el desplazamiento por el canal V, en la base es 0x viento =0 y en las puntas 1 x viento = se mueve",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -990.0,
        "y": -316.0,
        "width": 200.0,
        "height": 173.29385375976563
    },
    "m_Group": {
        "m_Id": ""
    }
}

